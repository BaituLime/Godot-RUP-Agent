{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "potato-agent/attempt-record.schema.json",
  "title": "Potato Agent Raw Attempt Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempt_format", "session_id", "module_id", "chain_revision_id", "scope_id", "node_id", "node_kind", "context_id", "attempt_id", "attempt_kind", "agent_name", "status", "craft_execution_report", "review_functional_report", "review_inspector_report", "partial_reason", "checkout", "branch", "module_worktree_id", "dispatch_audit", "read_audit", "search_audit", "artifacts", "notes", "first_blocker"],
  "properties": {
    "attempt_format": { "type": "string", "const": "potato_agent_attempt_record/v20" },
    "session_id": { "type": "string", "minLength": 1 },
    "module_id": { "type": "string", "minLength": 1 },
    "chain_revision_id": { "type": "string", "minLength": 1 },
    "scope_id": { "type": "string", "minLength": 1 },
    "node_id": { "type": "string", "minLength": 1 },
    "node_kind": { "type": "string", "enum": ["craft", "review"] },
    "context_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "pattern": "^attempt-[0-9]{3}$" },
    "attempt_kind": { "type": "string", "enum": ["craft_execution", "review_functional", "review_inspector"] },
    "agent_name": { "type": "string", "enum": ["potato-agent-craft", "potato-agent-review"] },
    "status": { "type": "string", "enum": ["ready_for_review", "continue_repair", "ready_for_inspector", "ready_for_settlement", "partial", "blocked"] },
    "partial_reason": { "type": ["string", "null"], "enum": [null, "node_incomplete", "packet_insufficient", "user_clarification_needed", "detail_override_needed"] },
    "craft_execution_report": { "anyOf": [{ "$ref": "#/$defs/craftExecutionReport" }, { "type": "null" }] },
    "review_functional_report": { "anyOf": [{ "$ref": "#/$defs/reviewFunctionalReport" }, { "type": "null" }] },
    "review_inspector_report": { "anyOf": [{ "$ref": "#/$defs/reviewInspectorReport" }, { "type": "null" }] },
    "checkout": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "module_worktree_id": { "type": "string", "minLength": 1 },
    "dispatch_audit": { "$ref": "#/$defs/dispatchAudit" },
    "read_audit": { "type": "array", "items": { "$ref": "#/$defs/readAuditEntry" } },
    "search_audit": { "type": "array", "items": { "$ref": "#/$defs/searchAuditEntry" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "first_blocker": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "attempt_kind": { "const": "craft_execution" } }, "required": ["attempt_kind"] },
      "then": { "properties": { "node_kind": { "const": "craft" }, "agent_name": { "const": "potato-agent-craft" }, "status": { "enum": ["ready_for_review", "continue_repair", "partial", "blocked"] }, "craft_execution_report": { "$ref": "#/$defs/craftExecutionReport" }, "review_functional_report": { "const": null }, "review_inspector_report": { "const": null } } }
    },
    {
      "if": { "properties": { "attempt_kind": { "const": "review_functional" } }, "required": ["attempt_kind"] },
      "then": { "properties": { "node_kind": { "const": "review" }, "agent_name": { "const": "potato-agent-review" }, "status": { "enum": ["ready_for_inspector", "continue_repair", "partial", "blocked"] }, "craft_execution_report": { "const": null }, "review_functional_report": { "$ref": "#/$defs/reviewFunctionalReport" }, "review_inspector_report": { "const": null } } }
    },
    {
      "if": { "properties": { "attempt_kind": { "const": "review_inspector" } }, "required": ["attempt_kind"] },
      "then": { "properties": { "node_kind": { "const": "review" }, "agent_name": { "const": "potato-agent-review" }, "status": { "enum": ["ready_for_settlement", "partial", "blocked"] }, "craft_execution_report": { "const": null }, "review_functional_report": { "const": null }, "review_inspector_report": { "$ref": "#/$defs/reviewInspectorReport" } } }
    },
    {
      "if": { "properties": { "attempt_kind": { "const": "review_functional" }, "status": { "const": "ready_for_inspector" } }, "required": ["attempt_kind", "status"] },
      "then": { "properties": { "review_functional_report": { "properties": { "functional_results": { "not": { "contains": { "properties": { "status": { "enum": ["fail", "blocked"] } }, "required": ["status"] } } }, "repair_deltas": { "maxItems": 0 } } } } }
    },
    {
      "if": { "properties": { "attempt_kind": { "const": "review_inspector" }, "status": { "const": "ready_for_settlement" } }, "required": ["attempt_kind", "status"] },
      "then": { "properties": { "review_inspector_report": { "properties": { "architecture_coverage": { "minItems": 1, "not": { "contains": { "properties": { "result": { "enum": ["drifted", "blocked"] } }, "required": ["result"] } } }, "inspection_findings": { "not": { "contains": { "properties": { "severity": { "const": "blocking" } }, "required": ["severity"] } } }, "repair_deltas": { "maxItems": 0 } } } } }
    }
  ],
  "$defs": {
    "surfaceType": { "type": "string", "enum": ["source_inspection", "code_inspection", "deterministic_model", "production_integration_probe", "normal_player_game_path"] },
    "craftExecutionReport": { "type": "object", "additionalProperties": false, "required": ["route_readback", "served_review_scenario_ids", "changed_production_files", "changed_test_files", "test_assets_changed", "debug_aids", "prior_check_failures_addressed", "self_check_results", "test_layer_results", "debug_test_cleanup_results", "structured_failures"], "properties": { "route_readback": { "type": "string", "minLength": 1 }, "served_review_scenario_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "changed_production_files": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "changed_test_files": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "test_assets_changed": { "type": "array", "items": { "$ref": "#/$defs/testAssetChange" } }, "debug_aids": { "type": "array", "items": { "$ref": "#/$defs/debugAid" } }, "prior_check_failures_addressed": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "self_check_results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/checkGateResult" } }, "test_layer_results": { "type": "array", "items": { "$ref": "#/$defs/testLayerResult" } }, "debug_test_cleanup_results": { "type": "array", "items": { "$ref": "#/$defs/testLayerResult" } }, "structured_failures": { "type": "array", "items": { "$ref": "#/$defs/structuredFailure" } }, "rerun_scope_recommendation": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "reviewFunctionalReport": { "type": "object", "additionalProperties": false, "required": ["functional_results", "regression_results", "debug_aid_review", "repair_deltas"], "properties": { "functional_results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/functionalResult" } }, "regression_results": { "type": "array", "items": { "$ref": "#/$defs/testLayerResult" } }, "debug_aid_review": { "type": "object", "additionalProperties": false, "required": ["read_before_independent_observation", "accepted_as_pass_evidence", "notes"], "properties": { "read_before_independent_observation": { "type": "boolean", "const": false }, "accepted_as_pass_evidence": { "type": "boolean", "const": false }, "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } } } }, "repair_deltas": { "type": "array", "items": { "$ref": "#/$defs/repairDelta" } } } },
    "reviewInspectorReport": { "type": "object", "additionalProperties": false, "required": ["inspection_summary", "architecture_coverage", "inspection_findings", "repair_deltas"], "properties": { "inspection_summary": { "$ref": "#/$defs/inspectionSummary" }, "architecture_coverage": { "type": "array", "items": { "$ref": "#/$defs/architectureCoverage" } }, "inspection_findings": { "type": "array", "items": { "$ref": "#/$defs/inspectionFinding" } }, "repair_deltas": { "type": "array", "items": { "$ref": "#/$defs/repairDelta" } } } },
    "checkGateResult": { "type": "object", "additionalProperties": false, "required": ["gate_id", "review_target_ids", "source_review_scenario_ids", "source_use_case_claim_ids", "status", "surface_used", "evidence", "limits"], "properties": { "gate_id": { "type": "string", "minLength": 1 }, "review_target_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "source_review_scenario_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "source_use_case_claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "status": { "type": "string", "enum": ["passed", "failed", "not_run", "blocked"] }, "surface_used": { "$ref": "#/$defs/surfaceType" }, "evidence": { "type": "string", "minLength": 1 }, "limits": { "type": "string", "minLength": 1 } } },
    "functionalResult": { "type": "object", "additionalProperties": false, "required": ["result_id", "review_target_id", "review_scenario_id", "source_use_case_claim_ids", "surface", "observation", "status", "failure_signature", "repair_target"], "properties": { "result_id": { "type": "string", "minLength": 1 }, "review_target_id": { "type": "string", "minLength": 1 }, "review_scenario_id": { "type": "string", "minLength": 1 }, "source_use_case_claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "surface": { "$ref": "#/$defs/surfaceType" }, "observation": { "type": "string", "minLength": 1 }, "status": { "type": "string", "enum": ["pass", "fail", "blocked"] }, "failure_signature": { "type": ["string", "null"], "minLength": 1 }, "repair_target": { "type": ["string", "null"], "minLength": 1 } } },
    "inspectionSummary": { "type": "object", "additionalProperties": false, "required": ["route_conformance", "scenario_path_hypotheses", "coverage_limits"], "properties": { "route_conformance": { "type": "string", "enum": ["aligned", "drifted", "unclear"] }, "scenario_path_hypotheses": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "coverage_limits": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "architectureCoverage": { "type": "object", "additionalProperties": false, "required": ["coverage_id", "inspection_item_id", "route_authority_ref", "source_route_implementation_detail_ids", "source_cross_cutting_contract_ids", "source_review_scenario_ids", "source_review_target_ids", "inspected_files_or_surfaces", "result", "evidence", "finding_ids", "coverage_limit"], "properties": { "coverage_id": { "type": "string", "minLength": 1 }, "inspection_item_id": { "type": "string", "minLength": 1 }, "route_authority_ref": { "type": "string", "minLength": 1 }, "source_route_implementation_detail_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "source_cross_cutting_contract_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "source_review_scenario_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "source_review_target_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "inspected_files_or_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "result": { "type": "string", "enum": ["aligned", "drifted", "blocked", "not_applicable"] }, "evidence": { "type": "string", "minLength": 1 }, "finding_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "coverage_limit": { "type": "string", "minLength": 1 } } },
    "inspectionFinding": { "type": "object", "additionalProperties": false, "required": ["finding_id", "severity", "category", "anchor", "route_authority_refs", "source_review_scenario_ids", "source_review_target_ids", "issue", "impact", "repair_target", "affected_rerun_scope"], "properties": { "finding_id": { "type": "string", "minLength": 1 }, "severity": { "type": "string", "enum": ["blocking", "warning"] }, "category": { "type": "string", "enum": ["architecture_fit", "fake_success", "cheap_route_substitute", "debug_test_cleanup", "lifecycle_state", "maintainability_performance", "scope_creep"] }, "anchor": { "type": ["string", "null"], "minLength": 1 }, "route_authority_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "source_review_scenario_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "source_review_target_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "issue": { "type": "string", "minLength": 1 }, "impact": { "type": "string", "minLength": 1 }, "repair_target": { "type": ["string", "null"], "minLength": 1 }, "affected_rerun_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "testLayerResult": { "type": "object", "additionalProperties": false, "required": ["layer", "status", "summary"], "properties": { "layer": { "type": "string", "enum": ["unit", "integration", "regression", "runtime_scenario", "visual", "build_import", "debug_test_cleanup"] }, "status": { "type": "string", "enum": ["passed", "failed", "not_run", "blocked"] }, "command": { "type": ["string", "null"] }, "summary": { "type": "string", "minLength": 1 } } },
    "structuredFailure": { "type": "object", "additionalProperties": false, "required": ["failure_id", "failure_signature", "rerun_scope"], "properties": { "failure_id": { "type": "string", "minLength": 1 }, "gate_id": { "type": ["string", "null"], "minLength": 1 }, "failure_signature": { "type": "string", "minLength": 1 }, "rejected_substitutes": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "rerun_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "dispatchAudit": { "type": "object", "additionalProperties": false, "required": ["requested_agent_name", "actual_model", "actual_agent_name", "dispatch_mode", "dispatch_verified"], "properties": { "requested_agent_name": { "type": "string", "enum": ["potato-agent-craft", "potato-agent-review"] }, "actual_model": { "type": "string", "minLength": 1 }, "actual_agent_name": { "type": "string", "minLength": 1 }, "dispatch_mode": { "type": "string", "const": "opencode_native_child" }, "dispatch_verified": { "type": "boolean" }, "notes": { "type": "string" } } },
    "readAuditEntry": { "type": "object", "additionalProperties": false, "required": ["path", "purpose", "within_read_plan"], "properties": { "path": { "type": "string", "minLength": 1 }, "purpose": { "type": "string", "minLength": 1 }, "within_read_plan": { "type": "boolean" } } },
    "searchAuditEntry": { "type": "object", "additionalProperties": false, "required": ["query", "paths", "purpose", "within_search_budget"], "properties": { "query": { "type": "string", "minLength": 1 }, "paths": { "type": "array", "items": { "type": "string", "minLength": 1, "not": { "enum": ["/", "/home/bunny", "~"] } } }, "purpose": { "type": "string", "minLength": 1 }, "within_search_budget": { "type": "boolean" } } },
    "artifactRef": { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "type": "string", "enum": ["diff", "log", "stdout", "stderr", "file", "screenshot", "video", "other"] }, "path": { "type": "string", "minLength": 1 } } },
    "testAssetChange": { "type": "object", "additionalProperties": false, "required": ["path", "purpose", "status"], "properties": { "path": { "type": "string", "minLength": 1 }, "purpose": { "type": "string", "minLength": 1 }, "status": { "type": "string", "enum": ["created", "updated", "deleted", "promoted"] } } },
    "debugAid": { "type": "object", "additionalProperties": false, "required": ["path", "purpose", "cleanup_status"], "properties": { "path": { "type": "string", "minLength": 1 }, "purpose": { "type": "string", "minLength": 1 }, "cleanup_status": { "type": "string", "enum": ["deleted", "promoted_to_test_asset", "blocking"] } } },
    "repairDelta": { "type": "object", "additionalProperties": false, "required": ["repair_delta_id", "source", "target", "failure_signature", "rejected_substitutes", "required_craft_self_check_gates", "affected_successors"], "properties": { "repair_delta_id": { "type": "string", "minLength": 1 }, "source": { "type": "object", "additionalProperties": false, "required": ["kind", "node_id", "attempt_ids", "review_target_ids", "review_scenario_ids", "source_use_case_claim_ids", "inspection_finding_ids", "human_final_review_record_path", "technical_final_review_record_path"], "properties": { "kind": { "type": "string", "enum": ["review_functional", "review_inspector", "human_final_review", "technical_final_review", "settlement", "user_directive", "mixed"] }, "node_id": { "type": ["string", "null"], "minLength": 1 }, "attempt_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "review_target_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "review_scenario_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "source_use_case_claim_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "inspection_finding_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "human_final_review_record_path": { "type": ["string", "null"], "minLength": 1 }, "technical_final_review_record_path": { "type": ["string", "null"], "minLength": 1 } } }, "target": { "type": "object", "additionalProperties": false, "required": ["node_id", "repair_mode"], "properties": { "node_id": { "type": ["string", "null"], "minLength": 1 }, "repair_mode": { "type": "string", "enum": ["craft_repair", "custom_craft_repair", "rewrite_packet", "promote_detail_override", "ask_user", "visible_replanning"] } } }, "failure_signature": { "type": "string", "minLength": 1 }, "rejected_substitutes": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "required_craft_self_check_gates": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "affected_successors": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["node_id", "why_stale", "review_target_ids_to_rerun", "review_scenario_ids_to_recheck", "inspection_focus_to_rerun"], "properties": { "node_id": { "type": "string", "minLength": 1 }, "why_stale": { "type": "string", "minLength": 1 }, "review_target_ids_to_rerun": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "review_scenario_ids_to_recheck": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "inspection_focus_to_rerun": { "type": "array", "items": { "type": "string", "minLength": 1 } } } } } } }
  }
}
