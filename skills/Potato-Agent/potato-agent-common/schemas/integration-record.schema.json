{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "potato-agent/integration-record.schema.json",
  "title": "Potato Agent Phase Integration Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "integration_record_format",
    "session_id",
    "module_id",
    "chain_revision_id",
    "integration_id",
    "settlement_id",
    "review_node_id",
    "settled_node_ids",
    "source_scope_ids",
    "module_worktree",
    "module_branch",
    "git_action",
    "worktree_review_check",
    "result",
    "result_commit",
    "first_blocker",
    "notes"
  ],
  "properties": {
    "integration_record_format": { "type": "string", "const": "potato_agent_integration_record/v4" },
    "session_id": { "type": "string", "minLength": 1 },
    "module_id": { "type": "string", "minLength": 1 },
    "chain_revision_id": { "type": "string", "minLength": 1 },
    "integration_id": { "type": "string", "minLength": 1 },
    "settlement_id": { "type": "string", "minLength": 1 },
    "review_node_id": { "type": "string", "minLength": 1 },
    "settled_node_ids": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "source_scope_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "module_worktree": { "type": "string", "minLength": 1 },
    "module_branch": { "type": "string", "minLength": 1 },
    "git_action": { "type": "string", "const": "commit" },
    "worktree_review_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "unrelated_change_paths", "unreviewed_change_paths"],
      "properties": {
        "status": { "type": "string", "enum": ["clean_for_phase_commit", "blocked_unknown_changes"] },
        "unrelated_change_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "unreviewed_change_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "result": { "type": "string", "enum": ["integrated", "blocked"] },
    "result_commit": { "type": ["string", "null"], "minLength": 1 },
    "first_blocker": { "type": ["string", "null"], "minLength": 1 },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "integrated" } }, "required": ["result"] },
      "then": {
        "properties": {
          "result_commit": { "type": "string", "minLength": 1 },
          "worktree_review_check": { "properties": { "status": { "const": "clean_for_phase_commit" } }, "required": ["status"] }
        }
      }
    },
    {
      "if": { "properties": { "result": { "const": "blocked" } }, "required": ["result"] },
      "then": { "properties": { "first_blocker": { "type": "string", "minLength": 1 } } }
    }
  ]
}
