{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "potato-agent/worktree-table.schema.json",
  "title": "Potato Agent Module Worktree Table",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "worktree_table_format",
    "session_id",
    "module_id",
    "module_worktree",
    "last_updated_at"
  ],
  "properties": {
    "worktree_table_format": {
      "type": "string",
      "const": "potato_agent_worktree_table/v2"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "module_worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "checkout",
        "branch",
        "status",
        "active_node_id",
        "last_commit"
      ],
      "properties": {
        "module_id": {
          "type": "string",
          "minLength": 1
        },
        "checkout": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "busy",
            "dirty",
            "cleaned"
          ]
        },
        "active_node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "last_updated_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
